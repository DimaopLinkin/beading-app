  "fixed_sql": [
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"device_id\" TEXT NOT NULL, \"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"device_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"craft\" TEXT NOT NULL DEFAULT 'beading', \"status\" TEXT NOT NULL DEFAULT 'idea', \"technique\" TEXT NOT NULL, \"content_kind\" TEXT NOT NULL, \"notes\" TEXT NOT NULL DEFAULT '', \"cover_path\" TEXT NULL, \"last_worked_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "easter_egg_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"easter_egg_log\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"egg_group\" TEXT NOT NULL, \"egg_id\" TEXT NOT NULL, \"shown_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "image_patterns",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"image_patterns\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"device_id\" TEXT NOT NULL, \"project_id\" TEXT NOT NULL REFERENCES projects (id), PRIMARY KEY (\"id\"), UNIQUE (\"project_id\"));"
        }
      ]
    },
    {
      "name": "image_pattern_pages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"image_pattern_pages\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"device_id\" TEXT NOT NULL, \"pattern_id\" TEXT NOT NULL REFERENCES image_patterns (id), \"position\" INTEGER NOT NULL, \"path\" TEXT NOT NULL, \"width\" INTEGER NOT NULL, \"height\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"pattern_id\", \"position\"));"
        }
      ]
    }
