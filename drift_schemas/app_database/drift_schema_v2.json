          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"device_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"craft\" TEXT NOT NULL DEFAULT 'beading', \"status\" TEXT NOT NULL DEFAULT 'idea', \"technique\" TEXT NOT NULL, \"content_kind\" TEXT NOT NULL, \"notes\" TEXT NOT NULL DEFAULT '', \"cover_path\" TEXT NULL, \"last_worked_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
